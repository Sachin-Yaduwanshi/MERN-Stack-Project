# StayPulse Backend Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/staypulse

# Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Authentication Secrets (Placeholder values only - set in your local .env)
JWT_SECRET=replace_with_a_secure_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# Financial & Tax Configuration (Indian Hospitality GST Default: 12%)
GST_TAX_RATE=0.12
